; Run `python deploy/generate.py` after changing the matrix. CI regenerates
; this file and fails on any difference, so an edit here is lost and noticed
; rather than lost and not (REQ-NFR-063).


[Unit]
Description=Home Inventory valkey

[Container]
ContainerName=homeinv-valkey
Image=docker.io/valkey/valkey@sha256:d2e18f3410b6f616de1417f570fa55261af2898b9c5b2cfb6781ce2373ea43d1
User=999:1000
ReadOnly=true
DropCapability=ALL
NoNewPrivileges=true
Network=homeinv-internal.network
Volume=homeinv-kvdata.volume:/data
Tmpfs=/tmp:mode=1777
Secret=valkey-password,type=mount
Secret=valkey-users.acl,type=mount,target=/etc/valkey/users.acl
Exec=valkey-server --aclfile /etc/valkey/users.acl --appendonly yes
HealthCmd=["CMD", "valkey-cli", "ping"]
HealthInterval=10s
HealthStartPeriod=30s

[Service]
MemoryMax=256M
MemoryLow=128M
Restart=on-failure

[Install]
WantedBy=default.target

[Unit]
Description=Home Inventory valkey

[Container]
ContainerName=homeinv-valkey
Image=docker.io/valkey/valkey@sha256:a0dbf4c1d5708782907c10e2c72deff317518518b5288a58416981d9db95d30b
User=999:1000
ReadOnly=true
DropCapability=ALL
NoNewPrivileges=true
Network=homeinv-internal.network:alias=valkey
Volume=homeinv-kvdata.volume:/data
Tmpfs=/tmp:mode=1777
Secret=valkey-password,type=mount
Secret=valkey-users.acl,type=mount,target=/etc/valkey/users.acl
Exec=valkey-server --aclfile /etc/valkey/users.acl --appendonly yes
HealthCmd=["valkey-cli", "ping"]
HealthInterval=10s
HealthStartPeriod=30s

[Service]
MemoryMax=256M
MemoryLow=128M
Restart=on-failure
[Unit]
Description=Home Inventory valkey

[Container]
ContainerName=homeinv-valkey
Image=docker.io/valkey/valkey:8-alpine
User=999:1000
ReadOnly=true
DropCapability=ALL
NoNewPrivileges=true
Network=homeinv-internal.network
Volume=homeinv-kvdata.volume:/data
Tmpfs=/tmp
Secret=valkey-password,type=mount
HealthCmd=valkey-cli ping
HealthInterval=10s
HealthStartPeriod=30s

[Service]
MemoryMax=256M
MemoryLow=128M
Restart=on-failure

[Install]
WantedBy=default.target

; rather than lost and not (REQ-NFR-063).


[Unit]
Description=Home Inventory api
Requires=homeinv-postgres.service
After=homeinv-postgres.service
Requires=homeinv-valkey.service
After=homeinv-valkey.service
Requires=homeinv-rabbitmq.service
After=homeinv-rabbitmq.service
Requires=homeinv-migrate.service
After=homeinv-migrate.service
Requires=homeinv-bootstrap.service
After=homeinv-bootstrap.service
Requires=homeinv-blobstore.service
After=homeinv-blobstore.service

[Container]
ContainerName=homeinv-api
Image=ghcr.io/greluc/home-inv:latest
User=10001:10001
ReadOnly=true
DropCapability=ALL
NoNewPrivileges=true
Network=homeinv-internal.network:alias=api-internal
Network=homeinv-frontend.network
Tmpfs=/tmp:mode=1777
Environment=SPRING_PROFILES_ACTIVE=api,${HOMEINV_PROFILE}
Environment=HOMEINV_DB_URL=jdbc:postgresql://postgres:5432/homeinv
Environment=HOMEINV_DB_USER=homeinv_app
Environment=MANAGEMENT_SERVER_PORT=8090
Environment=MANAGEMENT_SERVER_ADDRESS=api-internal
Environment=HOMEINV_TRUSTED_PROXIES=${HOMEINV_TRUSTED_PROXIES}
Environment=HOMEINV_PUBLIC_BASE_URL=${HOMEINV_PUBLIC_BASE_URL}
Environment=HOMEINV_MEDIA_BASE_URL=${HOMEINV_MEDIA_BASE_URL}
Environment=HOMEINV_BLOBSTORE_ENDPOINT=blobstore:8100
Environment=HOMEINV_BLOBSTORE_FINGERPRINT=${HOMEINV_BLOBSTORE_FINGERPRINT}
Environment=HOMEINV_VALKEY_HOST=valkey
Environment=HOMEINV_VALKEY_USER=homeinv
Environment=HOMEINV_MQ_HOST=rabbitmq
Environment=HOMEINV_MQ_USER=homeinv
Environment=HOMEINV_SEARCH_USER=homeinv
Environment=HOMEINV_DB_PASSWORD_FILE=/run/secrets/db-password
Environment=HOMEINV_DATA_ENCRYPTION_MASTER_KEY_FILE=/run/secrets/data-encryption-master-key
Environment=HOMEINV_JWT_SIGNING_KEY_FILE=/run/secrets/jwt-signing-key
Environment=HOMEINV_URL_SIGNING_KEY_FILE=/run/secrets/url-signing-key
Environment=HOMEINV_VALKEY_PASSWORD_FILE=/run/secrets/valkey-password
Environment=HOMEINV_MQ_PASSWORD_FILE=/run/secrets/mq-password
Environment=HOMEINV_SEARCH_PASSWORD_FILE=/run/secrets/search-password
Environment=HOMEINV_MTLS_CORE_FILE=/run/secrets/mtls-core
Secret=db-password,type=mount
Secret=data-encryption-master-key,type=mount
Secret=jwt-signing-key,type=mount
Secret=url-signing-key,type=mount
Secret=valkey-password,type=mount
Secret=mq-password,type=mount
Secret=search-password,type=mount
Secret=mtls-core,type=mount
HealthCmd=["CMD", "/usr/bin/healthcheck"]
HealthInterval=15s
HealthStartPeriod=90s
Notify=healthy

[Service]
MemoryMax=1536M
MemoryLow=768M
Restart=on-failure

[Install]
WantedBy=default.target

[Unit]
Description=Home Inventory rabbitmq

[Container]
ContainerName=homeinv-rabbitmq
Image=docker.io/library/rabbitmq@sha256:b3b8b7f95f5382a19f9ea33540e604f30aad081d37ad9aba72255135765373a1
User=999:999
ReadOnly=true
DropCapability=ALL
NoNewPrivileges=true
Network=homeinv-internal.network:alias=rabbitmq
Volume=homeinv-mqdata.volume:/var/lib/rabbitmq
Tmpfs=/tmp:mode=1777
Tmpfs=/var/log/rabbitmq:mode=1777
Secret=mq-password,type=mount
Secret=rabbitmq-rabbitmq.conf,type=mount,target=/etc/rabbitmq/rabbitmq.conf
HealthCmd=["rabbitmq-diagnostics", "-q", "ping"]
HealthInterval=20s
HealthStartPeriod=60s

[Service]
MemoryMax=512M
MemoryLow=256M
Restart=on-failure
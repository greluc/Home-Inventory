[Unit]
Description=Home Inventory blobstore

[Container]
ContainerName=homeinv-blobstore
Image=ghcr.io/greluc/home-inv-blobstore:latest
User=10001:10001
ReadOnly=true
DropCapability=ALL
NoNewPrivileges=true
Network=homeinv-internal.network:alias=blobstore
Volume=homeinv-blobdata.volume:/var/lib/homeinv/blobs
Tmpfs=/tmp:mode=1777
Secret=mtls-blobstore,type=mount
HealthCmd=["/homeinv-blobstore", "--health"]
HealthInterval=30s
HealthStartPeriod=30s

[Service]
MemoryMax=128M
MemoryLow=32M
Restart=on-failure
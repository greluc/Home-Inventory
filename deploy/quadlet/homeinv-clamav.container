; Run `python deploy/generate.py` after changing the matrix. CI regenerates
; this file and fails on any difference, so an edit here is lost and noticed
; rather than lost and not (REQ-NFR-063).


[Unit]
Description=Home Inventory clamav

[Container]
ContainerName=homeinv-clamav
Image=docker.io/clamav/clamav@sha256:1fdfd24c6f0a0fb60788481487459a6d4eda8a9b448641594e04db8410d34422
User=100:101
ReadOnly=true
DropCapability=ALL
NoNewPrivileges=true
Network=homeinv-scanner.network
Volume=homeinv-cvddata.volume:/var/lib/clamav
Tmpfs=/tmp:mode=1777
Tmpfs=/run/clamav:mode=1777
Tmpfs=/var/lock:mode=1777
Tmpfs=/var/log/clamav:mode=1777
Secret=clamav-freshclam.conf,type=mount,target=/etc/clamav/freshclam.conf
HealthCmd=["CMD", "clamdcheck.sh"]
HealthInterval=60s
HealthStartPeriod=300s

[Service]
MemoryMax=1536M
MemoryLow=1G
Restart=on-failure

[Install]
WantedBy=default.target

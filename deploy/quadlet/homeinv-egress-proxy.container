[Unit]
Description=Home Inventory egress-proxy

[Container]
ContainerName=homeinv-egress-proxy
Image=ghcr.io/greluc/home-inv-egress-proxy:latest
User=10001:10001
ReadOnly=true
DropCapability=ALL
NoNewPrivileges=true
Network=homeinv-scanner.network:alias=egress-proxy
Network=homeinv-egress.network:alias=egress-proxy
Network=homeinv-plugin-webhook.network:alias=egress-proxy
Network=homeinv-plugin-smtp.network:alias=egress-proxy
Network=homeinv-plugin-blobstore-s3.network:alias=egress-proxy
Tmpfs=/tmp:mode=1777
Tmpfs=/var/run:mode=1777
Secret=egress-proxy-egress-allowlist.conf,type=mount,target=/etc/homeinv/egress-allowlist.conf
HealthCmd=["/homeinv-egress-proxy", "--health"]
HealthInterval=30s
HealthStartPeriod=30s

[Service]
MemoryMax=32M
MemoryLow=16M
Restart=on-failure
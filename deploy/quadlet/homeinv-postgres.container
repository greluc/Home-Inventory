; GENERATED FROM ../services.yaml — DO NOT EDIT.
;
; Run `python deploy/generate.py` after changing the matrix. CI regenerates
; this file and fails on any difference, so an edit here is lost and noticed
; rather than lost and not (REQ-NFR-063).


[Unit]
Description=Home Inventory postgres

[Container]
ContainerName=homeinv-postgres
Image=ghcr.io/greluc/home-inv-postgres:latest
User=70:70
ReadOnly=true
DropCapability=ALL
NoNewPrivileges=true
Network=homeinv-internal.network
Volume=homeinv-pgdata.volume:/var/lib/postgresql
Volume=homeinv-pgwal.volume:/var/lib/homeinv/wal-archive
Tmpfs=/tmp:mode=1777
Tmpfs=/var/run/postgresql:mode=1777
Environment=POSTGRES_DB=homeinv
Environment=POSTGRES_PASSWORD_FILE=/run/secrets/postgres-superuser-password
Secret=postgres-superuser-password,type=mount
Secret=db-password,type=mount
Secret=db-migration-password,type=mount
Exec=postgres -c wal_level=replica -c archive_mode=on -c 'archive_command=test ! -f /var/lib/homeinv/wal-archive/%f && cp %p /var/lib/homeinv/wal-archive/%f' -c archive_timeout=900
HealthCmd=["CMD", "pg_isready"]
HealthInterval=10s
HealthStartPeriod=30s

[Service]
MemoryMax=2G
MemoryLow=1G
Restart=on-failure

[Install]
WantedBy=default.target

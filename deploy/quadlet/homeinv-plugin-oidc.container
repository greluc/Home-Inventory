[Unit]
Description=Home Inventory plugin-oidc

[Container]
ContainerName=homeinv-plugin-oidc
Image=ghcr.io/greluc/home-inv-plugin-oidc:latest
User=10001:10001
ReadOnly=true
DropCapability=ALL
NoNewPrivileges=true
Network=homeinv-plugin-oidc.network:alias=plugin-oidc
EnvironmentFile=%h/.config/homeinv/homeinv.env
Environment=HOMEINV_PLUGIN_PORT=8204
Environment=HOMEINV_MTLS_PLUGIN_FILE=/run/secrets/mtls-plugin-oidc
Environment=HOMEINV_EGRESS_PROXY=egress-proxy:8118
Environment=HOMEINV_OIDC_TIMEOUT_SECONDS=20
Secret=mtls-plugin-oidc,type=mount
Secret=plugin-oidc-client-secret,type=mount

[Service]
MemoryMax=512M
MemoryLow=192M
Restart=on-failure
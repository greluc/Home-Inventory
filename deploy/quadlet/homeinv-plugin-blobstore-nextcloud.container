[Unit]
Description=Home Inventory plugin-blobstore-nextcloud

[Container]
ContainerName=homeinv-plugin-blobstore-nextcloud
Image=ghcr.io/greluc/home-inv-plugin-blobstore-nextcloud:latest
User=10001:10001
ReadOnly=true
DropCapability=ALL
NoNewPrivileges=true
Network=homeinv-plugin-blobstore-nextcloud.network:alias=plugin-blobstore-nextcloud
EnvironmentFile=%h/.config/homeinv/homeinv.env
Environment=HOMEINV_PLUGIN_PORT=8203
Environment=HOMEINV_MTLS_PLUGIN_FILE=/run/secrets/mtls-plugin-blobstore-nextcloud
Environment=HOMEINV_EGRESS_PROXY=egress-proxy:8118
Environment=HOMEINV_NEXTCLOUD_TIMEOUT_SECONDS=60
Secret=mtls-plugin-blobstore-nextcloud,type=mount
Secret=plugin-blobstore-nextcloud-password,type=mount

[Service]
MemoryMax=256M
MemoryLow=64M
Restart=on-failure
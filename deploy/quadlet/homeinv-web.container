; rather than lost and not (REQ-NFR-063).


[Unit]
Description=Home Inventory web
Requires=homeinv-api.service
After=homeinv-api.service

[Container]
ContainerName=homeinv-web
Image=ghcr.io/greluc/home-inv-web:latest
User=10001:10001
ReadOnly=true
DropCapability=ALL
NoNewPrivileges=true
Network=homeinv-edge.network
Network=homeinv-frontend.network
Tmpfs=/tmp:mode=1777
Tmpfs=/var/cache/nginx:mode=1777
Tmpfs=/var/run:mode=1777
PublishPort=8080:8080
HealthCmd=["CMD", "/healthcheck"]
HealthInterval=15s
HealthStartPeriod=30s

[Service]
MemoryMax=256M
MemoryLow=64M
Restart=on-failure

[Install]
WantedBy=default.target

{
  "name": "home-inv-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && node scripts/i18n.mjs && vite build && node scripts/csp.mjs && npm run sbom",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "csp:check": "node scripts/csp.mjs --check",
    "sbom": "cyclonedx-npm --omit dev --omit optional --omit peer --spec-version 1.6 --output-reproducible --output-format JSON --output-file dist/sbom.json",
    "i18n:check": "node scripts/i18n.mjs",
    "client:generate": "node scripts/client.mjs",
    "client:check": "node scripts/client.mjs --check",
    "lint": "oxlint --deny-warnings"
  },
  "dependencies": {
    "i18next": "26.4.2",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.13"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "^6.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "^30.1.1",
    "oxlint": "1.82.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  },
  "overrides": {
    "react-i18next": {
      "typescript": "$typescript"
    }
  }
}

{
  "name": "home-inv-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && node scripts/i18n.mjs && vite build && node scripts/csp.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "csp:check": "node scripts/csp.mjs --check",
    "i18n:check": "node scripts/i18n.mjs",
    "contract:check": "node scripts/contract.mjs",
    "lint": "oxlint --deny-warnings"
  },
  "dependencies": {
    "i18next": "25.6.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "16.2.4"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "oxlint": "1.82.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "4.0.18"
  },
  "overrides": {
    "react-i18next": {
      "typescript": "$typescript"
    }
  }
}
